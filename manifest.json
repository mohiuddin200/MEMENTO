{
  "manifest_version": 3,
  "name": "Memento — Death Clock & Death Rate",
  "short_name": "Memento",
  "version": "1.3.0",
  "minimum_chrome_version": "88",
  "homepage_url": "https://github.com/mohiuddin200/MEMENTO",
  "description": "A dark memento mori new tab: your personal death countdown, plus the real-time birth and death rate for your country or the world.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://api.worldbank.org/*"]
}
